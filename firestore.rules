rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.email in ['baranimoley@gmail.com', 'barandivatyali@gmail.com'];
    }
    
    // Kullanıcıya özel ana veri dokümanı: Sadece kimliği doğrulanmış doküman sahibi okuyabilir/yazabilir
    match /users/{userId} {
      allow read, write, delete: if request.auth != null && request.auth.uid == userId;
    }

    // Topluluk kullanıcı profilleri: Keşfet/profil vitrini herkese açık, yazma ve silme oturum açmış kullanıcıya özel
    match /community_users/{docId} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // Kullanıcı adı dizini: Arkadaş arama ve benzersizlik kontrolü için herkese açık okuma
    match /usernames/{username} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // Topluluk mekanları ve yorumları
    match /community_places/{placeId} {
      allow read: if true;
      allow create: if request.auth != null && (!('uid' in request.resource.data) || request.resource.data.uid == request.auth.uid);
      allow update, delete: if isAdmin() || (request.auth != null && (resource.data.userId == request.auth.uid || resource.data.uid == request.auth.uid));
    }

    match /community_reviews/{reviewId} {
      allow read: if true;
      allow create: if request.auth != null && (!('uid' in request.resource.data) || request.resource.data.uid == request.auth.uid);
      allow update, delete: if isAdmin() || (request.auth != null && (resource.data.userId == request.auth.uid || resource.data.uid == request.auth.uid));
    }

    // Kullanıcı geri bildirimleri (Yalnızca admin veya bildirim sahibi okuyabilir/yönetebilir)
    match /user_feedbacks/{feedbackId} {
      allow create: if true;
      allow read, update, delete: if isAdmin() || (request.auth != null && (resource.data.uid == request.auth.uid || resource.data.userId == request.auth.uid));
    }

    match /feedbacks/{feedbackId} {
      allow create: if true;
      allow read, update, delete: if isAdmin() || (request.auth != null && (resource.data.uid == request.auth.uid || resource.data.userId == request.auth.uid));
    }

    // Seyahat davetleri
    match /trip_invitations/{invId} {
      allow read, create, update: if request.auth != null;
      allow delete: if request.auth != null && (resource.data.userId == request.auth.uid || resource.data.uid == request.auth.uid);
    }
  }
}
