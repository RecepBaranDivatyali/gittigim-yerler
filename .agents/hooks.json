{
  "gezgin-session-start": {
    "SessionStart": [
      {
        "type": "command",
        "command": "node scripts/session-start.mjs",
        "timeout": 10
      }
    ]
  },
  "gezgin-failure-tracker": {
    "PostToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/track-failures.mjs",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "gezgin-stop-guard": {
    "Stop": [
      {
        "type": "command",
        "command": "node scripts/stop-guard.mjs",
        "timeout": 10
      }
    ]
  }
}
